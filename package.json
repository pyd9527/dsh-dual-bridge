{
  "name": "dsh-dual-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "双向沟通桥：把已装的 ds-harness-remote 通道封装成模型可直接调用的跨机工具（发消息、取回复、列对端工作区与会话），复用现有身份与 relay，零侵入。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
